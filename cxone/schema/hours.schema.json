{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "profiles",
    "holidays",
    "catSwitchProfile"
  ],
  "properties": {
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "timezone",
          "days"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "description": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "days": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "Mon",
                "Tue",
                "Wed",
                "Thu",
                "Fri",
                "Sat",
                "Sun"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-4]):[0-5][0-9]$"
                }
              }
            }
          }
        }
      }
    },
    "holidays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "date",
          "closes"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "closes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60
            }
          }
        }
      }
    },
    "catSwitchProfile": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    }
  }
}