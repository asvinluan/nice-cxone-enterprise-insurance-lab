{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "campaign",
    "skills"
  ],
  "additionalProperties": true,
  "properties": {
    "campaign": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "mediaType",
          "division",
          "primaryTeam",
          "overflow",
          "slaPercent",
          "slaSeconds",
          "acwSeconds",
          "record"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "kind": {
            "enum": [
              "queue",
              "language"
            ]
          },
          "mediaType": {
            "enum": [
              "Voice",
              "Chat",
              "Email"
            ]
          },
          "division": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "primaryTeam": {
            "type": "string"
          },
          "overflow": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "afterSeconds",
                "team"
              ],
              "additionalProperties": false,
              "properties": {
                "afterSeconds": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 900
                },
                "team": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 60
                }
              }
            }
          },
          "slaPercent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "slaSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600
          },
          "acwSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600
          },
          "record": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}