{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "prefix",
    "timezone",
    "brands"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "prefix": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}$"
    },
    "timezone": {
      "type": "string"
    },
    "brands": {
      "type": "array",
      "minItems": 1
    }
  }
}