{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "pointsOfContact"
  ],
  "properties": {
    "pointsOfContact": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "number",
          "brand",
          "script",
          "hoursProfile",
          "parameters",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "number": {
            "type": "string",
            "pattern": "^\\+61355500[0-9]{3}$"
          },
          "brand": {
            "enum": [
              "KMH",
              "KBU",
              "KRG"
            ]
          },
          "script": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "hoursProfile": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "parameters": {
            "type": "object"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}