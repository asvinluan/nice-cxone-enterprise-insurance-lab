{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "dispositions"
  ],
  "properties": {
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "classification"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "description": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "Resolved",
              "Care",
              "Transferred",
              "Abandoned"
            ]
          }
        }
      }
    }
  }
}